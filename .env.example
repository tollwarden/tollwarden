# --- Core ---
PORT=4021
# live = x402 payments enforced | dev = everything free (local testing)
TOLLWARDEN_MODE=live
# Your receiving wallet (USDC lands here). REQUIRED in live mode.
PAY_TO=0xYourAddress
# Public URL of this deployment (used in the /.well-known manifest and agent card)
PUBLIC_BASE_URL=https://tollwarden.onrender.com
# Google Analytics 4 measurement ID for the public pages (/, /terms, /privacy,
# /contact), behind an opt-in cookie banner. Leave unset on self-hosted
# deployments: unset means no analytics, no banner, no Google hosts in the CSP.
# Only takes effect with an https PUBLIC_BASE_URL.
#GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- x402 / settlement ---
# eip155:8453 = Base mainnet, eip155:84532 = Base Sepolia testnet
X402_NETWORK=eip155:8453
# cdp = Coinbase CDP facilitator (mainnet + Bazaar indexing) | x402org = free testnet facilitator
X402_FACILITATOR=cdp
# CDP API keys (https://portal.cdp.coinbase.com) — required when X402_FACILITATOR=cdp
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- Pricing ---
PRICE_SCAN=$0.01
PRICE_REPUTATION=$0.01
FREE_CALLS=100

# --- Detection thresholds ---
OVERPAY_FLAG_MULTIPLE=3
OVERPAY_BLOCK_MULTIPLE=10
MAX_PAYMENT_USD=10
NONCE_TTL_HOURS=24

# --- Zero-latency hardening tier ---
# Scans per agent per minute: flag at this rate, block at 2x
MAX_PAYMENTS_PER_MINUTE=10
# Cumulative scanned spend per agent per hour (USD): block above
MAX_USD_PER_HOUR=5
# First payment to a never-seen counterparty above this (USD) is flagged
FIRST_PAYMENT_MAX_USD=1
# Payments under this (USD) skip the deep content-analysis tier (policy.force_deep overrides)
MICRO_BYPASS_USD=0.005
# Set to "on" to downgrade non-canonical-USDC assets from block to flag
ALLOW_NON_USDC=off
# TOFU merchant pinning (domain -> pay_to). "off" to disable.
PINNING=on
# Async (non-blocking) CDP Bazaar cross-check of pins. Enable in live deployments.
CDP_PIN_VERIFY=off
# ScoutScore external trust signal for merchant domains (scoutscore.ai).
# Async + cached, flag-only (never blocks). Shares scanned resource DOMAINS
# (nothing else) with ScoutScore — see PRIVACY.md §6. "on" to enable.
SCOUTSCORE=off
# Override the ScoutScore API base URL (tests/self-hosted mirrors)
#SCOUTSCORE_URL=https://scoutscore.ai
# Ed25519-signed verdicts (public key at /.well-known/tollwarden-verdict-key). "off" to disable.
VERDICT_SIGNING=on
# JSON array of known-bad addresses (default: <DATA_DIR>/badlist.json)
#BADLIST_PATH=/data/badlist.json

# --- Audit & resource bounds ---
# Tamper-evident hash-chained audit log of scan decisions (<DATA_DIR>/audit.log). "off" to disable.
AUDIT_LOG=on
# Max entries per in-memory Map before oldest-first eviction (memory/disk DoS bound)
MAX_STORE_ENTRIES=100000
# Free-endpoint abuse limits
KEYS_PER_IP_PER_DAY=10
REPORTS_PER_IP_PER_HOUR=30
APPROVAL_ACTIONS_PER_IP_PER_HOUR=60
OUTCOMES_PER_IP_PER_HOUR=600

# --- Delivery-outcome check (flag-only) ---
# Minimum commitment-bound outcomes before the delivery-rate check fires
DELIVERY_MIN_OUTCOMES=5
# Delivery rate below this flags the counterparty (never blocks)
DELIVERY_FLAG_RATE=0.7

# --- Human-in-the-loop step-up approvals ---
# Feature switch: "off" disables approvals entirely (no new configs, no new
# approvals; flags stay advisory-only). In-flight approvals remain decidable.
APPROVALS=on
# How long a pending approval waits for a human decision before expiring
APPROVALS_PENDING_TTL_MINUTES=10
# Override attestation lifetime (seconds; structurally capped at 300)
OVERRIDE_TTL_SECONDS=300
# Max in-flight approval records (creation refuses when full -- fail closed)
APPROVALS_MAX=10000

# --- Storage ---
DATA_DIR=./data
