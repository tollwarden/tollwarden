{
  "name": "tollwarden",
  "version": "1.6.0",
  "mcpName": "com.tollwarden/tollwarden",
  "description": "TollWarden — a payment security firewall for x402 micropayment traffic. Advisory scanning: PII/secret leaks, replay, overpayment, prompt-injection-triggered payments, counterparty reputation. Non-custodial. Includes an MCP server: npx tollwarden",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "tollwarden": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "HOME.md",
    "TERMS.md",
    "PRIVACY.md",
    "server.json"
  ],
  "homepage": "https://tollwarden.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tollwarden/tollwarden.git"
  },
  "keywords": [
    "x402",
    "mcp",
    "payments",
    "security",
    "firewall",
    "ai-agents",
    "prompt-injection",
    "usdc",
    "base"
  ],
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc",
    "start": "node dist/src/index.js",
    "dev": "node --experimental-strip-types src/devserver.ts",
    "demo:replay": "node --experimental-strip-types examples/replay-demo.ts",
    "gen:wallet": "node --experimental-strip-types examples/gen-test-wallet.ts",
    "dryrun": "node --experimental-strip-types examples/paid-dryrun.ts",
    "test": "node --experimental-strip-types test/run-tests.ts",
    "eval": "node --experimental-strip-types eval/run-eval.ts",
    "mcp": "node dist/mcp/server.js",
    "version": "node scripts/sync-version.mjs && git add server.json",
    "prepublishOnly": "npm run build && npm test && npm run eval",
    "test:quiet": "bash scripts/test-quiet.sh npm test",
    "eval:quiet": "bash scripts/test-quiet.sh npm run eval"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/express": "^2.0.0",
    "@x402/extensions": "^2.0.0",
    "express": "^4.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@x402/fetch": "^2.0.0",
    "typescript": "^5.7.0",
    "viem": "^2.21.0"
  },
  "license": "BUSL-1.1"
}
