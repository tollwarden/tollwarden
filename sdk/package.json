{
  "name": "@tollwarden/client",
  "version": "0.7.0",
  "description": "Official client SDK for TollWarden — the payment security firewall for x402 micropayments. Scan payments before settlement, auto-tag provenance for prompt-injection detection, verify Ed25519 verdict attestations, and subscribe to plans autonomously.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-strip-types test/run-tests.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "x402",
    "payments",
    "security",
    "firewall",
    "ai-agents",
    "prompt-injection",
    "usdc",
    "base",
    "micropayments"
  ],
  "homepage": "https://tollwarden.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tollwarden/tollwarden.git",
    "directory": "sdk"
  },
  "license": "BUSL-1.1",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
